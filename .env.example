POSTGRES_DB=dbrepairs
# Use a different long, random value for each password below.
# DBRepairs refuses to start while a password still says replace-with.
# Database administrator. Only the one-time db-init step uses it.
POSTGRES_USER=dbrepairs
POSTGRES_PASSWORD=replace-with-a-long-random-admin-password
# Restricted database account used by the application and the backups.
APP_DB_USER=dbrepairs_app
APP_DB_PASSWORD=replace-with-a-long-random-app-password
# The password people type to sign in to DBRepairs in the browser (8+ characters).
DBREPAIRS_PASSWORD=replace-with-the-shop-login-password
DBREPAIRS_PORT=8080
DATABASE_POOL_SIZE=10
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
TZ=Europe/Lisbon
# Repair photos live in their own Docker volume (dbrepairs_repair_photos) unless
# you point this at a host folder, e.g. /srv/dbrepairs-photos (owned by uid 1000).
# PHOTOS_PATH=
# Turns on the password vault (customer logins, encrypted). Use 32+ random characters,
# for example from: openssl rand -base64 32. Never change or lose it once passwords are saved.
# VAULT_KEY=
# Email from the app (customer notices, invoices). Without these, the app opens your own email app.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# tls (port 465), starttls (587) or none (25). Chosen from the port when empty.
# SMTP_SECURITY=
# SMTP_USER=shop@example.com
# SMTP_PASSWORD=
# SMTP_FROM=Your Shop <shop@example.com>
# Text messages through Twilio (optional).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550001234
# Off-site copies (only with: docker compose --profile offsite up -d). See docker/README.md.
# OFFSITE_REMOTE=b2:my-bucket/dbrepairs
# OFFSITE_INTERVAL_SECONDS=86400
